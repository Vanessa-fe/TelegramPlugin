{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:frontend"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:api"
      ],
      "port": 3002
    },
    {
      "name": "emails-brevo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4599",
        "--bind",
        "127.0.0.1",
        "-d",
        "docs/emails-brevo"
      ],
      "port": 4599
    }
  ]
}
