{
  "name": "telegram-monetization",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:api": "pnpm --filter api start:dev",
    "dev:bot": "pnpm --filter bot dev",
    "dev:discord-bot": "pnpm --filter discord-bot dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:stack:old": "bash scripts/dev-stack.sh",
    "dev:stack": "ENV_FILE=.env.development bash scripts/dev-stack.sh",
    "prod:stack": "ENV_FILE=.env.production bash scripts/dev-stack.sh",
    "db:deploy": "bash scripts/db-deploy.sh",
    "deploy:api:dev": "fly deploy --config fly.toml -a telegram-plugin-api",
    "deploy:api:prod": "fly deploy --config fly.prod.toml -a sublynk-api"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.0.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.20.0"
  }
}
