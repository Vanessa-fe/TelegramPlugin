generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ORG_ADMIN
  SUPPORT
  VIEWER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanInterval {
  ONE_TIME
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
  EXPIRED
}

enum ChannelProvider {
  TELEGRAM
  DISCORD
  WHATSAPP
}

enum ChannelType {
  CHANNEL
  GROUP
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  USED
}

enum AccessStatus {
  PENDING
  GRANTED
  REVOKE_PENDING
  REVOKED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  TELEGRAM_STARS
}

enum PaymentEventType {
  CHECKOUT_COMPLETED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  INVOICE_PAID
  INVOICE_PAYMENT_FAILED
  REFUND_CREATED
}

enum InviteStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PlatformSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ConversionStatus {
  PENDING
  APPROVED
  CANCELLED
  PAID
}

enum AffiliateProgramStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CommissionAppliesTo {
  ALL_PRODUCTS
  SPECIFIC_PRODUCTS
}

enum CouponType {
  PERCENTAGE    // ex: 20% off
  FIXED_AMOUNT  // ex: 5€ off
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum LandingPageElementType {
  SOCIAL_LINKS    // Liens réseaux sociaux
  IMAGE           // Avatar/Logo
  HEADING_1       // Titre principal
  HEADING_2       // Sous-titre
  HEADING_3       // Section title
  TEXT            // Paragraphe descriptif
  PRODUCTS        // Liste des produits/accès
  LINK            // Lien personnalisé
  DIVIDER         // Séparateur
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  TWITTER
  TIKTOK
  TELEGRAM
  DISCORD
  LINKEDIN
  WEBSITE
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  pageSlug        String?  // Custom slug for public landing page (e.g., "vanessa" instead of "ferrand-vf-0dxwfh")
  billingEmail    String
  currency        String   @default("EUR")
  stripeAccountId String?  @unique
  saasActive      Boolean  @default(false)
  suspendedAt     DateTime? // Manual suspension by SUPERADMIN - null = not suspended
  suspendReason   String?   // Reason for manual suspension
  timezone        String?  @default("UTC")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Ambassador program fields
  ambassadorTier      AmbassadorTier @default(NONE)
  ambassadorSince     DateTime?
  lastLoyaltyRewardAt DateTime?

  users                 User[]
  customers             Customer[]
  products              Product[]
  channels              Channel[]
  channelVerifications  ChannelVerification[]
  subscriptions         Subscription[]
  paymentEvents         PaymentEvent[]
  auditLogs             AuditLog[]
  dataExports           DataExport[]
  platformSubscription  PlatformSubscription?
  affiliateProgram      AffiliateProgram?
  affiliates            Affiliate[]
  coupons               Coupon[]
  landingPage           LandingPage?
  teamInvites           TeamInvite[]
  tickets               Ticket[]

  @@index([slug])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            UserRole  @default(ORG_ADMIN)
  firstName       String?
  lastName        String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  organizationId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization?  @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  dataExports    DataExport[]
  oauthAccounts  OAuthAccount[]
  resetTokens    PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  refreshTokens  RefreshToken[]
  sentTeamInvites TeamInvite[] @relation("TeamInviteInvitedBy")
  assignedTickets Ticket[]       @relation("TicketAssignedTo")
  ticketMessages  TicketMessage[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TeamInvite {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           UserRole
  tokenHash      String    @unique
  invitedByUserId String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("TeamInviteInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([organizationId, email])
  @@index([organizationId, createdAt])
}

model Customer {
  id               String       @id @default(uuid())
  organizationId   String
  email            String?
  displayName      String?
  telegramUserId   String?
  telegramUsername String?
  discordUserId    String?
  discordUsername  String?
  externalId       String?      @unique
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  organization        Organization @relation(fields: [organizationId], references: [id])
  subscriptions       Subscription[]
  channelAccesses     ChannelAccess[]
  entitlements        Entitlement[]
  affiliateReferrals  AffiliateReferral[]
  discordAccount      CustomerDiscordAccount?

  @@index([organizationId, telegramUserId])
  @@index([organizationId, discordUserId])
}

model Product {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         ProductStatus  @default(DRAFT)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id])
  plans           Plan[]
  channels        ProductChannel[]

  @@index([organizationId, status])
  @@unique([organizationId, name])
}

model Plan {
  id               String        @id @default(uuid())
  productId        String
  name             String
  description      String?
  interval         PlanInterval
  priceCents       Int
  currency         String
  trialPeriodDays  Int?
  accessDurationDays Int?
  isActive         Boolean       @default(true)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product       Product       @relation(fields: [productId], references: [id])
  subscriptions Subscription[]

  @@index([productId, isActive])
}

model Channel {
  id               String           @id @default(uuid())
  organizationId   String
  provider         ChannelProvider  @default(TELEGRAM)
  type             ChannelType      @default(CHANNEL)
  externalId       String
  title            String?
  username         String?
  inviteLink       String?
  isActive         Boolean          @default(true)
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id])
  productLinks    ProductChannel[]
  channelAccesses ChannelAccess[]
  invites         TelegramInvite[]
  discordGuild    DiscordGuild?

  @@unique([organizationId, provider, externalId])
}

model ChannelVerification {
  id               String             @id @default(uuid())
  organizationId   String
  provider         ChannelProvider    @default(TELEGRAM)
  code             String             @unique
  type             ChannelType        @default(CHANNEL)
  status           VerificationStatus @default(PENDING)
  // Telegram fields
  telegramChatId   String?
  telegramTitle    String?
  telegramUsername String?
  // Discord fields
  discordGuildId   String?
  discordGuildName String?
  discordRoleId    String?
  discordRoleName  String?
  expiresAt        DateTime
  verifiedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([code])
  @@index([organizationId])
  @@index([status, expiresAt])
}

model ProductChannel {
  id        String   @id @default(uuid())
  productId String
  channelId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([productId, channelId])
  @@index([channelId])
}

model Subscription {
  id                  String              @id @default(uuid())
  organizationId      String
  customerId          String
  planId              String
  slug                String?
  status              SubscriptionStatus  @default(ACTIVE)
  externalId          String?             @unique
  externalCustomerId  String?
  externalPriceId     String?
  startedAt           DateTime            @default(now())
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  trialEndsAt         DateTime?
  canceledAt          DateTime?
  endedAt             DateTime?
  graceUntil          DateTime?
  lastPaymentFailedAt DateTime?
  affiliateCode       String?
  couponCode          String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id])
  plan               Plan                @relation(fields: [planId], references: [id])
  channelAccesses    ChannelAccess[]
  paymentEvents      PaymentEvent[]
  entitlements       Entitlement[]
  affiliateReferral  AffiliateReferral?
  couponUsage        CouponUsage?

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([customerId])
}

enum EntitlementType {
  CHANNEL_ACCESS
  FEATURE_FLAG
  CONTENT_UNLOCK
  API_QUOTA
}

model Entitlement {
  id             String          @id @default(uuid())
  subscriptionId String
  customerId     String
  entitlementKey String
  type           EntitlementType @default(CHANNEL_ACCESS)
  resourceId     String?
  grantedAt      DateTime        @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@unique([subscriptionId, entitlementKey])
  @@index([customerId, entitlementKey])
  @@index([subscriptionId])
}

model ChannelAccess {
  id             String       @id @default(uuid())
  subscriptionId String
  channelId      String
  customerId     String
  inviteId       String?      // For Telegram - links to TelegramInvite
  discordRoleId  String?      // For Discord - the role that was assigned
  status         AccessStatus @default(PENDING)
  grantedAt      DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  channel      Channel       @relation(fields: [channelId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  invite       TelegramInvite? @relation(fields: [inviteId], references: [id])

  @@unique([subscriptionId, channelId])
  @@index([channelId, status])
}

model TelegramInvite {
  id           String       @id @default(uuid())
  channelId    String
  inviteLink   String
  inviteHash   String?
  status       InviteStatus @default(ACTIVE)
  expiresAt    DateTime?
  maxUses      Int?
  usesCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?
  revokedReason String?
  lastSyncedAt DateTime?

  channel        Channel        @relation(fields: [channelId], references: [id])
  channelAccesses ChannelAccess[]

  @@unique([channelId, inviteLink])
}

model PaymentEvent {
  id             String            @id @default(uuid())
  organizationId String
  subscriptionId String?
  provider       PaymentProvider
  type           PaymentEventType
  externalId     String
  payload        Json
  occurredAt     DateTime          @default(now())
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, externalId])
  @@index([subscriptionId])
}

model AuditLog {
  id              String         @id @default(uuid())
  organizationId  String
  actorId         String?
  actorType       AuditActorType @default(USER)
  action          String
  resourceType    String
  resourceId      String?
  correlationId   String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([correlationId])
}

model DataExport {
  id             String           @id @default(uuid())
  organizationId String
  requestedById  String?
  status         DataExportStatus @default(PENDING)
  requestedAt    DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  slaDueAt       DateTime
  slaMet         Boolean?
  archivePath    String?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  requestedBy  User?        @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status])
  @@index([slaDueAt])
}

model PlatformPlan {
  id              String       @id @default(uuid())
  name            String       @unique
  displayName     String
  priceCents      Int
  currency        String       @default("eur")
  interval        PlanInterval @default(MONTH)
  trialPeriodDays Int?         @default(14)
  stripePriceId   String?      @unique
  features        Json?
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptions PlatformSubscription[]
}

model PlatformSubscription {
  id                   String                     @id @default(uuid())
  organizationId       String                     @unique
  platformPlanId       String
  status               PlatformSubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?                    @unique
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean                    @default(false)
  graceUntil           DateTime?
  metadata             Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  platformPlan PlatformPlan @relation(fields: [platformPlanId], references: [id])

  @@index([status])
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AffiliateProgram {
  id                    String                 @id @default(uuid())
  organizationId        String                 @unique
  name                  String
  commissionValue       Int                    // Default commission rate (%)
  attributionWindowDays Int                    @default(30)
  validationDelayDays   Int                    @default(14)
  appliesTo             CommissionAppliesTo    @default(ALL_PRODUCTS)
  productIds            String[]               // Only used when appliesTo = SPECIFIC_PRODUCTS
  status                AffiliateProgramStatus @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Affiliate {
  id              String          @id @default(uuid())
  organizationId  String
  email           String
  name            String?
  referralCode    String          @unique
  commissionRate  Int             // Percentage (10 = 10%) - overrides program default
  status          AffiliateStatus @default(PENDING)
  totalEarnings   Int             @default(0)
  pendingEarnings Int             @default(0)
  paidEarnings    Int             @default(0)
  totalClicks     Int             @default(0)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  referrals    AffiliateReferral[]
  payouts      AffiliatePayout[]
  clicks       AffiliateClick[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([referralCode])
}

model AffiliateClick {
  id          String   @id @default(uuid())
  affiliateId String
  visitorId   String   // Unique visitor identifier (cookie/localStorage)
  ipHash      String?  // Hashed IP for fraud detection
  userAgent   String?
  landingPage String?
  referrer    String?
  createdAt   DateTime @default(now())

  affiliate Affiliate           @relation(fields: [affiliateId], references: [id])
  referrals AffiliateReferral[]

  @@index([affiliateId, createdAt])
  @@index([visitorId])
}

model AffiliateReferral {
  id              String           @id @default(uuid())
  affiliateId     String
  subscriptionId  String           @unique
  customerId      String
  clickId         String?          // Link to the click that led to this conversion
  productId       String?          // Product associated with this referral
  amountCents     Int
  commissionCents Int
  currency        String           @default("eur")
  // Legacy field - kept for backwards compatibility, use status instead
  isPaid          Boolean          @default(false)
  // New status workflow
  status          ConversionStatus @default(PENDING)
  approvedAt      DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())

  // Stripe IDs for refund matching (one-time payments don't have invoice/subscription)
  stripePaymentIntentId String? // pi_... from checkout session
  stripeChargeId        String? // ch_... from payment intent latest_charge

  affiliate    Affiliate       @relation(fields: [affiliateId], references: [id])
  subscription Subscription    @relation(fields: [subscriptionId], references: [id])
  customer     Customer        @relation(fields: [customerId], references: [id])
  click        AffiliateClick? @relation(fields: [clickId], references: [id])

  @@index([affiliateId, status])
  @@index([affiliateId, isPaid])
  @@index([status, createdAt])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
}

model AffiliatePayout {
  id          String       @id @default(uuid())
  affiliateId String
  amountCents Int
  currency    String       @default("eur")
  status      PayoutStatus @default(PENDING)
  method      String?
  notes       String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
}

model Coupon {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  type           CouponType
  discountValue  Int          // % or cents depending on type
  currency       String?      // Required for FIXED_AMOUNT
  status         CouponStatus @default(ACTIVE)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  planIds        String[]     // Empty = all plans
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  usages       CouponUsage[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([code])
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  subscriptionId String   @unique
  customerId     String
  discountCents  Int
  originalCents  Int
  createdAt      DateTime @default(now())

  coupon       Coupon       @relation(fields: [couponId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([couponId])
}

model LandingPage {
  id             String   @id @default(uuid())
  organizationId String   @unique

  // Config générale
  isPublished    Boolean  @default(false)
  themeColor     String?  @default("#7c3aed")  // Purple par défaut

  // Metadata SEO
  metaTitle      String?
  metaDescription String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  elements       LandingPageElement[]
  socialLinks    SocialLink[]

  @@index([organizationId])
}

model LandingPageElement {
  id            String                @id @default(uuid())
  landingPageId String
  type          LandingPageElementType
  order         Int

  // Contenu (selon le type)
  content       String?               // Pour TEXT, HEADING, LINK text
  imageUrl      String?               // Pour IMAGE
  linkUrl       String?               // Pour LINK

  // Config spécifique
  settings      Json?                 // Options additionnelles (couleur, style, etc.)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, order])
}

model SocialLink {
  id            String         @id @default(uuid())
  landingPageId String
  platform      SocialPlatform
  url           String
  order         Int

  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, order])
}

// ========== Discord Integration Models ==========

model DiscordGuild {
  id             String       @id @default(uuid())
  channelId      String       @unique
  guildId        String       // Discord server ID
  guildName      String?      // Server name for display
  roleId         String?      // Role to assign for paid access
  roleName       String?      // Role name for display
  botJoinedAt    DateTime?    // When the bot joined the guild
  status         InviteStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  channel        Channel      @relation(fields: [channelId], references: [id])

  @@index([guildId])
}

model CustomerDiscordAccount {
  id              String   @id @default(uuid())
  customerId      String   @unique // One Discord account per customer
  discordUserId   String   @unique
  discordUsername String?
  accessToken     String?  // Encrypted - for API calls on behalf of user
  refreshToken    String?  // Encrypted - for token refresh
  tokenExpiresAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id])
}

// ========== Gift Codes (Platform Admin Only) ==========

enum GiftCodeStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum VipInvitationStatus {
  PENDING           // Email sent, waiting for activation
  ACTIVATED         // User created account
  CONVERTED         // Trial ended, user subscribed
  EXPIRED           // Trial expired without conversion
  CANCELLED         // Manually cancelled by admin
}

enum AmbassadorTier {
  NONE
  BRONZE    // 3+ mois 🟢
  SILVER    // 6+ mois 🟢
  GOLD      // 12+ mois 🟢 + high revenue
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model GiftCode {
  id               String         @id @default(uuid())
  code             String         @unique
  description      String?        // Note interne pour l'admin
  status           GiftCodeStatus @default(ACTIVE)
  maxUses          Int?           // null = illimité
  usedCount        Int            @default(0)
  expiresAt        DateTime?
  // Restrictions optionnelles (pour codes produit)
  planIds          String[]       // Vide = tous les plans
  organizationIds  String[]       // Vide = toutes les organisations
  // Mode essai plateforme (pour testeurs SaaS)
  isPlatformTrial  Boolean        @default(false)
  platformPlanName String?        // "starter", "growth", "pro"
  trialDays        Int?           // Durée de l'essai en jours
  createdById      String         // SUPERADMIN qui a créé le code
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  usages           GiftCodeUsage[]

  @@index([code])
  @@index([status])
}

model GiftCodeUsage {
  id             String   @id @default(uuid())
  giftCodeId     String
  subscriptionId String   @unique
  customerId     String
  customerEmail  String?
  planId         String
  organizationId String
  createdAt      DateTime @default(now())

  giftCode       GiftCode @relation(fields: [giftCodeId], references: [id])

  @@index([giftCodeId])
  @@index([customerId])
}

// ========== VIP Invitations (SUPERADMIN Dashboard) ==========

model VipInvitation {
  id                 String              @id @default(uuid())
  email              String
  token              String              @unique @default(uuid())
  status             VipInvitationStatus @default(PENDING)

  // Invitation parameters
  platformPlanName   String              // "starter", "growth", "pro"
  trialDays          Int                 // Duration of free trial

  // Tracking
  emailSentAt        DateTime?
  activatedAt        DateTime?
  convertedAt        DateTime?
  expiresAt          DateTime?           // Trial expiration date (set on activation)
  lastReportSentAt   DateTime?           // For VIP monthly reports

  // Metrics (populated after activation)
  organizationId     String?             // Organization created by VIP
  offersCreated      Int                 @default(0)
  salesGenerated     Int                 @default(0) // In cents

  // Admin info
  createdById        String              // SUPERADMIN who created invitation
  notes              String?             // Internal notes
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([email])
  @@index([status])
  @@index([token])
}

// ========== Support Tickets ==========

model Ticket {
  id             String         @id @default(uuid())
  organizationId String
  subject        String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  assignedToId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  closedAt       DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  assignedTo     User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  messages       TicketMessage[]

  @@index([organizationId])
  @@index([status])
  @@index([assignedToId])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  isInternal Boolean @default(false)  // Internal notes not visible to creator
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}
